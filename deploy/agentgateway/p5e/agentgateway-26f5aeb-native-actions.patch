diff --git a/ui/src/managedGateway.ts b/ui/src/managedGateway.ts
new file mode 100644
index 0000000..6d2ceea
--- /dev/null
+++ b/ui/src/managedGateway.ts
@@ -0,0 +1,32 @@
+import type { VirtualApiKey } from '@/types';
+
+export const operatorKeyMarker = 'bbx_operator_managed';
+
+export function localPlaygroundMode() {
+	return document.querySelector<HTMLMetaElement>('meta[name="bbx-native-playground"]')?.content;
+}
+
+export function managedGateway() {
+	const mode = localPlaygroundMode();
+	return mode === 'enabled' || mode === 'disabled';
+}
+
+export function publicLlmOrigin() {
+	return document.querySelector<HTMLMetaElement>('meta[name="bbx-native-data-origin"]')?.content;
+}
+
+export function operatorKey(key: VirtualApiKey) {
+	return (key.metadata as Record<string, unknown> | undefined)?.[operatorKeyMarker] === true;
+}
+
+const operatorLlmPolicies = new Set([
+	'cors',
+	'guardrails',
+	'localRateLimit',
+	'remoteRateLimit',
+	'timeout'
+]);
+
+export function managedPolicyReadOnly(kind: string, id: string) {
+	return managedGateway() && (kind !== 'llm.policy' || !operatorLlmPolicies.has(id));
+}
