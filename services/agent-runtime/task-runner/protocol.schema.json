          "title": "Leaf Id"
        },
        "anchor_offset": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Anchor Offset",
          "type": "integer"
        },
        "anchor_size": {
          "maximum": 2097152,
          "minimum": 0,
          "title": "Anchor Size",
          "type": "integer"
        },
        "anchor_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Anchor Hash",
          "type": "string"
