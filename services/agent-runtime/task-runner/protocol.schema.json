        },
        "binding": {
          "$ref": "#/$defs/RunnerBinding"
        },
        "sdk_session_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Sdk Session Id",
