{
  "$defs": {
    "AbortPayload": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "abort",
          "title": "Kind",
          "type": "string"
        },
        "binding_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Binding Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "binding_id"
      ],
      "title": "AbortPayload",
      "type": "object"
    },
    "ClosePayload": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "close",
          "title": "Kind",
          "type": "string"
        },
        "binding_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Binding Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "binding_id"
      ],
      "title": "ClosePayload",
      "type": "object"
    },
    "CommandReceipt": {
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "const": "bbx.task-runner.v1",
          "title": "Protocol",
          "type": "string"
        },
        "request_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Request Id",
          "type": "string"
        },
        "payload_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Payload Digest",
          "type": "string"
        },
        "fence": {
          "$ref": "#/$defs/RunnerFence"
        },
        "status": {
          "enum": [
            "prepared",
            "accepted",
            "applied",
            "aborted",
            "closed",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        },
        "binding_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Binding Id"
        },
        "sdk_session_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sdk Session Id"
        },
        "cursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/JournalCursor"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "input_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Id"
        },
        "unresolved_attempts": {
          "items": {
            "type": "string"
          },
          "title": "Unresolved Attempts",
          "type": "array"
        },
        "unresolved_invocations": {
          "items": {
            "type": "string"
          },
          "title": "Unresolved Invocations",
          "type": "array"
        },
        "sdk_idle": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sdk Idle"
        },
        "helper_run_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Helper Run Id"
        },
        "journal_confirmed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Journal Confirmed"
        },
        "pending_confirmation": {
          "anyOf": [
            {
              "$ref": "#/$defs/JournalConfirmation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "supported_business_contracts": {
          "items": {
            "const": "challenge-board-v1",
            "type": "string"
          },
          "title": "Supported Business Contracts",
          "type": "array"
        },
        "error_code": {
          "anyOf": [
            {
              "enum": [
                "stale_fence",
                "request_conflict",
                "binding_unavailable",
                "boundary_frozen",
                "unsupported_model"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        }
      },
      "required": [
        "protocol",
        "request_id",
        "payload_digest",
        "fence",
        "status"
      ],
      "title": "CommandReceipt",
      "type": "object"
    },
    "EffectiveRunnerModel": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "model_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Revision"
        },
        "api": {
          "const": "openai-completions",
          "title": "Api",
          "type": "string"
        },
        "input": {
          "items": {
            "enum": [
              "text",
              "image"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Input",
          "type": "array"
        },
        "reasoning": {
          "title": "Reasoning",
          "type": "boolean"
        },
        "thinking_level": {
          "enum": [
            "off",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "title": "Thinking Level",
          "type": "string"
        },
        "thinking_level_map": {
          "anyOf": [
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "propertyNames": {
                "enum": [
                  "off",
                  "minimal",
                  "low",
                  "medium",
                  "high",
                  "xhigh",
                  "max"
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thinking Level Map"
        },
        "thinking_budgets": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "integer"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thinking Budgets"
        },
        "context_window": {
          "minimum": 1024,
          "title": "Context Window",
          "type": "integer"
        },
        "max_output_tokens": {
          "minimum": 1,
          "title": "Max Output Tokens",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "api",
        "input",
        "reasoning",
        "thinking_level",
        "context_window",
        "max_output_tokens"
      ],
      "title": "EffectiveRunnerModel",
      "type": "object"
    },
    "HelperChild": {
      "additionalProperties": false,
      "properties": {
        "child_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Child Id",
          "type": "string"
        },
        "parent_binding_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Parent Binding Id",
          "type": "string"
        },
        "deadline_ms": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Deadline Ms",
          "type": "integer"
        },
        "mode": {
          "anyOf": [
            {
              "const": "background",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mode"
        }
      },
      "required": [
        "child_id",
        "parent_binding_id",
        "deadline_ms"
      ],
      "title": "HelperChild",
      "type": "object"
    },
    "InputApplication": {
      "additionalProperties": false,
      "properties": {
        "input_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Input Id",
          "type": "string"
        },
        "entry_id": {
          "title": "Entry Id",
          "type": "string"
        },
        "seq": {
          "minimum": 1,
          "title": "Seq",
          "type": "integer"
        }
      },
      "required": [
        "input_id",
        "entry_id",
        "seq"
      ],
      "title": "InputApplication",
      "type": "object"
    },
    "InputPayload": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "input",
          "title": "Kind",
          "type": "string"
        },
        "binding_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Binding Id",
          "type": "string"
        },
        "input_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Input Id",
          "type": "string"
        },
        "content": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "mode": {
          "default": "follow_up",
          "enum": [
            "steer",
            "follow_up"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "binding_id",
        "input_id",
        "content"
      ],
      "title": "InputPayload",
      "type": "object"
    },
    "JournalConfirmation": {
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "const": "bbx.task-runner.v1",
