        "cursor": {
          "$ref": "#/$defs/JournalCursor"
        },
        "applied_inputs": {
          "items": {
            "$ref": "#/$defs/InputApplication"
          },
          "title": "Applied Inputs",
          "type": "array"
        }
      },
      "required": [
        "protocol",
        "request_id",
        "fence",
        "binding",
        "sdk_session_id",
