        <mxCell id="23" value="R6 子任务结束" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=18;fontColor=#243247;fontStyle=1;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="22">
          <mxGeometry x="18" y="12" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="24" value="产物与费用持久化，执行清理并结算后释放名额；owner 决定采用或否定。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=17;fontColor=#243247;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="22">
