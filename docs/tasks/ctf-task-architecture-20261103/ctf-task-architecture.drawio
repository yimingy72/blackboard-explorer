          <mxGeometry x="60" y="834" width="970" height="80" as="geometry" />
        </mxCell>
        <mxCell id="29" value="R8 故障与恢复" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=18;fontColor=#243247;fontStyle=1;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="28">
          <mxGeometry x="18" y="12" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="30" value="可证明局部的失败只影响该工作；共享状态不明走恢复，未知副作用不重放。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=17;fontColor=#243247;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="28">
          <mxGeometry x="210" y="10" width="735" height="60" as="geometry" />
        </mxCell>
        <mxCell id="31" value="子 Agent 的最小权限" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=25;fontColor=#243247;fontStyle=1;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1100" y="165" width="640" height="40" as="geometry" />
        </mxCell>
        <mxCell id="32" value="&lt;div style=&quot;line-height:1.32;text-align:left;&quot;&gt;&lt;b style=&quot;font-size:19px;&quot;&gt;允许&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;&quot;&gt;只读本题获授权的题面、附件快照与共享记录&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=16;fontColor=#243247;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1100" y="225" width="640" height="82" as="geometry" />
        </mxCell>
        <mxCell id="33" value="&lt;div style=&quot;line-height:1.32;text-align:left;&quot;&gt;&lt;b style=&quot;font-size:19px;&quot;&gt;按需授予&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;&quot;&gt;命令经 envd；独立输出目录、受限工具与资源&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=16;fontColor=#243247;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1100" y="317" width="640" height="82" as="geometry" />
        </mxCell>
        <mxCell id="34" value="&lt;div style=&quot;line-height:1.32;text-align:left;&quot;&gt;&lt;b style=&quot;font-size:19px;&quot;&gt;允许&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;&quot;&gt;追加自己的观察 / 候选，结果返回父 owner&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=16;fontColor=#243247;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1100" y="409" width="640" height="82" as="geometry" />
        </mxCell>
        <mxCell id="35" value="&lt;div style=&quot;line-height:1.32;text-align:left;&quot;&gt;&lt;b style=&quot;font-size:19px;&quot;&gt;禁止&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;&quot;&gt;改 owner、认领别题、宣布整题完成或直接计分&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=16;fontColor=#243247;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1100" y="501" width="640" height="82" as="geometry" />
        </mxCell>
        <mxCell id="36" value="&lt;div style=&quot;line-height:1.32;text-align:left;&quot;&gt;&lt;b style=&quot;font-size:19px;&quot;&gt;默认禁止&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;&quot;&gt;启停靶机、直接提交 flag、访问平台凭据&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=16;fontColor=#243247;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1100" y="593" width="640" height="82" as="geometry" />
        </mxCell>
        <mxCell id="37" value="&lt;div style=&quot;line-height:1.32;text-align:left;&quot;&gt;&lt;b style=&quot;font-size:19px;&quot;&gt;禁止&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;&quot;&gt;再创建孙 Agent、扩大权限、修改预算或安装扩展&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=16;fontColor=#243247;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1100" y="685" width="640" height="82" as="geometry" />
        </mxCell>
        <mxCell id="38" value="&lt;div style=&quot;line-height:1.32;text-align:left;&quot;&gt;&lt;b style=&quot;font-size:22px;&quot;&gt;权限由平台执行&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;&quot;&gt;有效权限 = 任务授权 ∩ owner可委派权限 ∩ 子模板 ∩ 本次请求&lt;br&gt;不默认继承父会话、密钥和全部扩展；工具白名单不等于沙箱&lt;br&gt;父 scope 失效或用户停止：撤销派工并回收子执行&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=16;fontColor=#243247;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="1100" y="805" width="640" height="155" as="geometry" />
        </mxCell>
        <mxCell id="39" value="&lt;div style=&quot;line-height:1.32;text-align:left;&quot;&gt;&lt;b style=&quot;font-size:22px;&quot;&gt;容量示例：为什么既能铺开，也不超额&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;&quot;&gt;假设 24 道独立题：16 道离线就绪 + 8 道需在线实例；总工作名额 20，靶机配额 3。&lt;br&gt;先运行 16 个离线 owner + 3 个在线 owner = 19；其余 5 道在线题等实例，不空开 Agent。&lt;br&gt;某 owner 有独立离线分析分支，可使用最后 1 个名额启动子 Agent：19 owner + 1 child = 20。&lt;br&gt;仅示意：假定模型、预算和计算准入均允许。旧 max_teammates 名册语义不自动改变。&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=18;fontColor=#243247;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="990" width="1680" height="195" as="geometry" />
        </mxCell>
