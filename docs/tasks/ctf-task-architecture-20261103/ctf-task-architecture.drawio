        </mxCell>
        <mxCell id="26" value="R7 交接与停止" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=18;fontColor=#243247;fontStyle=1;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="25">
          <mxGeometry x="18" y="12" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="27" value="停新派工，撤销旧范围，收拢相关子执行；确认清理后才转交责任。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=17;fontColor=#243247;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="25">
