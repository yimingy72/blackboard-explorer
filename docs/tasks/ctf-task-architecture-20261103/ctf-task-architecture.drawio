          <mxGeometry x="60" y="573" width="970" height="80" as="geometry" />
        </mxCell>
        <mxCell id="20" value="R5 容量已满" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=18;fontColor=#243247;fontStyle=1;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="19">
          <mxGeometry x="18" y="12" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="21" value="不把未获准子任务当作已启动；owner 继续独立路线，或明确交接后让位。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=17;fontColor=#243247;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="19">
