        <mxCell id="9" value="逐题登记；有题面和可访问来源即可盘点。目录未读完不挡住已就绪题。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=17;fontColor=#243247;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="7">
