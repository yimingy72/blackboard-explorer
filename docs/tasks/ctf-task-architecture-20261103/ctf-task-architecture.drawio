          <mxGeometry x="1640" y="40" width="100" height="30" as="geometry" />
        </mxCell>
        <mxCell id="4" value="首版只允许 owner → 子 Agent 一层委派；分工关系归 owner，执行权与费用账本归平台。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=18;fontColor=#536277;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="95" width="1680" height="35" as="geometry" />
        </mxCell>
        <mxCell id="5" value="2026-11-03  ·  CTF 自动模式目标架构  ·  新增规则尚未部署；旧任务保留冻结语义" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=15;fontColor=#66758a;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="1230" width="1680" height="30" as="geometry" />
