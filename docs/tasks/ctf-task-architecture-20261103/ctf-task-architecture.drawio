        <mxCell id="2" value="CTF 任务架构：全局分题，题内委派" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=34;fontColor=#243247;fontStyle=1;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="30" width="1580" height="55" as="geometry" />
        </mxCell>
        <mxCell id="3" value="01 / 02" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontFamily=PingFang SC;fontSize=17;fontColor=#7b8798;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1640" y="40" width="100" height="30" as="geometry" />
        </mxCell>
        <mxCell id="4" value="一题一个 owner；owner 可申请同题子 Agent。调度、预算、权限与停止仍由平台统一约束。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=18;fontColor=#536277;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="95" width="1680" height="35" as="geometry" />
        </mxCell>
        <mxCell id="5" value="2026-11-03  ·  CTF 自动模式目标架构  ·  新增规则尚未部署；旧任务保留冻结语义" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=15;fontColor=#66758a;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="1230" width="1680" height="30" as="geometry" />
        </mxCell>
        <mxCell id="6" value="&lt;div style=&quot;line-height:1.32;text-align:left;&quot;&gt;&lt;span style=&quot;font-size:13px;color:#536277;&quot;&gt;入口 · 既有&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:22px;&quot;&gt;比赛任务与授权范围&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;&quot;&gt;目标题库、题面与初始附件&lt;br&gt;总预算 / 时限 / 成员上限；允许的靶场&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=18;fontColor=#243247;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="170" width="440" height="140" as="geometry" />
        </mxCell>
        <mxCell id="7" value="&lt;div style=&quot;line-height:1.32;text-align:left;&quot;&gt;&lt;span style=&quot;font-size:13px;color:#536277;&quot;&gt;1 名 · 既有角色，协调规则扩展&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:22px;&quot;&gt;Lead：全局策略与例外&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;&quot;&gt;离线优先、重点题优先级、跨题资源取舍&lt;br&gt;接收汇总与升级；不逐条转发题内消息&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=18;fontColor=#243247;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="680" y="170" width="440" height="140" as="geometry" />
        </mxCell>
        <mxCell id="8" value="&lt;div style=&quot;line-height:1.32;text-align:left;&quot;&gt;&lt;span style=&quot;font-size:13px;color:#536277;&quot;&gt;建议扩展 · 名额与请求并发分别计算&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:22px;&quot;&gt;统一准入与权限&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;&quot;&gt;owner + 子 Agent 共享工作名额&lt;br&gt;模型 / 命令 / 靶机分别限额；停止优先&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=18;fontColor=#243247;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="1300" y="170" width="440" height="140" as="geometry" />
        </mxCell>
        <mxCell id="9" value="&lt;div style=&quot;line-height:1.32;text-align:left;&quot;&gt;&lt;span style=&quot;font-size:13px;color:#536277;&quot;&gt;台账既有 · 完整目录映射待接入&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:22px;&quot;&gt;① 逐题台账&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;&quot;&gt;稳定题目 ID → 一题一行，分类仅分组&lt;br&gt;题面、输入引用、owner、状态、验证回执&lt;br&gt;目录逐页导入；已发现题先推进&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=17;fontColor=#243247;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="430" width="440" height="180" as="geometry" />
        </mxCell>
        <mxCell id="10" value="&lt;div style=&quot;line-height:1.32;text-align:left;&quot;&gt;&lt;span style=&quot;font-size:13px;color:#536277;&quot;&gt;建议新增 · 复用数据库事务与邮箱&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:22px;&quot;&gt;② 代码调度器&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;&quot;&gt;可执行题查询 → 选空闲成员 → 原子派工&lt;br&gt;优先独立题覆盖；空闲容量再用于增援&lt;br&gt;无可用容量时说明原因，不重复派工&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=17;fontColor=#243247;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="680" y="430" width="440" height="190" as="geometry" />
        </mxCell>
        <mxCell id="11" value="③ 题内执行组（子 Agent 新增）" style="swimlane;html=1;startSize=42;container=1;collapsible=0;pointerEvents=0;rounded=1;arcSize=6;fillColor=#dae8fc;swimlaneFillColor=#f8fbff;strokeColor=#6c8ebf;fontFamily=PingFang SC;fontSize=21;fontStyle=1;align=left;spacingLeft=16;" vertex="1" parent="1">
          <mxGeometry x="1300" y="430" width="440" height="260" as="geometry" />
        </mxCell>
        <mxCell id="12" value="&lt;div style=&quot;line-height:1.32;text-align:left;&quot;&gt;&lt;b style=&quot;font-size:19px;&quot;&gt;题目 owner&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;&quot;&gt;自主选路线；合并证据；统一交付&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=16;fontColor=#243247;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;spacing=8;" vertex="1" parent="11">
          <mxGeometry x="20" y="55" width="400" height="80" as="geometry" />
        </mxCell>
        <mxCell id="13" value="&lt;div style=&quot;line-height:1.32;text-align:left;&quot;&gt;&lt;b style=&quot;font-size:19px;&quot;&gt;子 Agent A&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;&quot;&gt;分析附件 / 独立假设&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=14;fontColor=#243247;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;spacing=8;" vertex="1" parent="11">
          <mxGeometry x="20" y="175" width="190" height="65" as="geometry" />
        </mxCell>
        <mxCell id="14" value="&lt;div style=&quot;line-height:1.32;text-align:left;&quot;&gt;&lt;b style=&quot;font-size:19px;&quot;&gt;子 Agent B&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;&quot;&gt;复核结果 / 脚本实验&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=14;fontColor=#243247;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;spacing=8;" vertex="1" parent="11">
          <mxGeometry x="230" y="175" width="190" height="65" as="geometry" />
        </mxCell>
        <mxCell id="15" value="获准委派" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;strokeColor=#6c8ebf;fontFamily=PingFang SC;fontSize=16;fontColor=#425466;labelBackgroundColor=#ffffff;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=0;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="12" target="13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="16" value="获准委派" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;strokeColor=#6c8ebf;fontFamily=PingFang SC;fontSize=16;fontColor=#425466;labelBackgroundColor=#ffffff;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=0;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="12" target="14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="17" value="&lt;div style=&quot;line-height:1.32;text-align:left;&quot;&gt;&lt;span style=&quot;font-size:13px;color:#536277;&quot;&gt;真实平台适配待接入 · 代码执行&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:22px;&quot;&gt;材料与实例准备&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;&quot;&gt;批量取材 → 校验 → 登记不可变输入&lt;br&gt;可离线则交付材料；可释放时归还实例&lt;br&gt;有可执行步骤就先盘点，不等全部下载&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=17;fontColor=#243247;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="760" width="440" height="150" as="geometry" />
        </mxCell>
        <mxCell id="18" value="&lt;div style=&quot;line-height:1.32;text-align:left;&quot;&gt;&lt;span style=&quot;font-size:13px;color:#536277;&quot;&gt;记录既有 · 父子归属与合并规则新增&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:22px;&quot;&gt;④ 题内成果与共享证据&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;&quot;&gt;子 Agent → owner：产物、依据、阻塞&lt;br&gt;owner 决定采用；关键成果写共享记录&lt;br&gt;Lead 接收摘要与需要全局处理的例外&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=17;fontColor=#243247;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="680" y="760" width="440" height="150" as="geometry" />
        </mxCell>
        <mxCell id="19" value="&lt;div style=&quot;line-height:1.32;text-align:left;&quot;&gt;&lt;span style=&quot;font-size:13px;color:#536277;&quot;&gt;候选机制既有 · 真实提交适配待接入&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:22px;&quot;&gt;⑤ 提交与可信验证&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;&quot;&gt;owner / 授权服务提交候选&lt;br&gt;accepted 才记平台得分；拒绝则针对性复核&lt;br&gt;unknown 先查询回执，不盲目重交&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=17;fontColor=#243247;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="1300" y="760" width="440" height="150" as="geometry" />
        </mxCell>
        <mxCell id="20" value="&lt;div style=&quot;line-height:1.32;text-align:left;&quot;&gt;&lt;span style=&quot;font-size:13px;color:#536277;&quot;&gt;建议规则 · 不将等待当作失败&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:22px;&quot;&gt;等待与恢复&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;&quot;&gt;材料 / 实例 / 预算 / 限流分别记录&lt;br&gt;条件恢复才重新评估；不靠模型轮询&lt;br&gt;子任务没获准：owner 继续本地路线&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=17;fontColor=#243247;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="1000" width="440" height="150" as="geometry" />
        </mxCell>
        <mxCell id="21" value="&lt;div style=&quot;line-height:1.32;text-align:left;&quot;&gt;&lt;span style=&quot;font-size:13px;color:#536277;&quot;&gt;复用现有顺序 · 不新增清理服务&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:22px;&quot;&gt;⑥ 既有结算链释放成员&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;&quot;&gt;保存交付 → stop_member / drain&lt;br&gt;→ finish_turn → 允许安全接下一项&lt;br&gt;子任务同样清理结算后释放槽位&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=17;fontColor=#243247;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="680" y="1000" width="440" height="150" as="geometry" />
        </mxCell>
        <mxCell id="22" value="&lt;div style=&quot;line-height:1.32;text-align:left;&quot;&gt;&lt;span style=&quot;font-size:13px;color:#536277;&quot;&gt;既有收尾 · 子执行必须纳入停止范围&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:22px;&quot;&gt;比赛结果与任务收尾&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;&quot;&gt;Lead 核对完整范围、逐题结果和未解项&lt;br&gt;目标达成：汇总得分 / 解题记录&lt;br&gt;停止或预算耗尽：保存部分成果后收尾&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=17;fontColor=#243247;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="1300" y="1000" width="440" height="150" as="geometry" />
        </mxCell>
