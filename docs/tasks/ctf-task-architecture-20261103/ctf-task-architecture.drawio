        <mxCell id="8" value="R1 发现新题" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=18;fontColor=#243247;fontStyle=1;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="7">
          <mxGeometry x="18" y="12" width="180" height="55" as="geometry" />
