POSTGRES_USER=blackboard
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=blackboard
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
MINIO_ROOT_USER=blackboard
MINIO_ROOT_PASSWORD=replace-me
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=blackboard
DEEPSEEK_BASE_URL=https://api.deepseek.com
BLACKBOARD_URL=http://blackboard:8000
EXEC_NETWORK=blackboard-explorer_exec
EXEC_ACCESS_MODE=network
EXEC_EGRESS_MODE=direct
EXEC_NETWORK_INTERNAL=false
EXEC_MIN_PIDS=1024
EGRESS_PROXY_URL=http://egress-proxy:8888
RUNTIME_HTTP_PROXY=
RUNTIME_HTTPS_PROXY=
SERVICE_TOKEN=replace-me
AGENT_TOKEN_SECRET=replace-me
ENVD_TOKEN_SECRET=replace-me
ENVD_TOKEN=replace-me
EGRESS_ALLOWLIST=eval-targets
MAX_RUNNING_TASKS=2
TRAFFIC_ENABLED=true
TRAFFIC_POLL_SECONDS=1
TRAFFIC_MAX_BYTES=2147483648
ADMIN_USERS=replace-me
OTEL_ENABLED=false

# Native standalone gateway; one stable logical ID per persistent accounting database.
NATIVE_GATEWAY_ACCOUNTING_SOURCE_ID=
NATIVE_GATEWAY_ADMIN_URL=
NATIVE_GATEWAY_DATA_URL=
NATIVE_GATEWAY_ADMIN_TOKEN=
# Catalog-only key must be denied inference by the gateway's fixed policy.
GATEWAY_CATALOG_READ_KEY=
# Enable review key creation on only one site per shared AgentGateway.
GATEWAY_REVIEW_KEY_OWNER=false
GATEWAY_MODEL_MANAGEMENT_URL=
GATEWAY_SITE_ID=
# Same private value on both sites sharing one AgentGateway.
GATEWAY_REVIEW_KEY=
# The secondary pins the original resource ID confirmed by the publisher.
GATEWAY_REVIEW_KEY_ID=
GATEWAY_RUNTIME_DATA_URL=
GATEWAY_MAINTENANCE_KEY=
# Map each exact site ID to its trusted private BB origin.
GATEWAY_MAINTENANCE_PEERS={}
NATIVE_GATEWAY_CATALOG_REVISION=
# Enable the trusted Runtime model listener only after the fixed gateway is configured.
# RUNNER_GATEWAY_URL=http://agentgateway:4000
# RUNNER_PROXY_PORT=8021

# RSA PKCS8 PEM for short-lived Runner MCP capabilities; kept only by Blackboard.
RUNNER_MCP_SIGNING_KEY=
# Independent native MCP backend credential; shared only by Blackboard and agentgateway.
RUNNER_MCP_BACKEND_TOKEN=

# Shared Virtual MCP gateway origin and private Blackboard backend origin (no Task path).
NATIVE_MCP_GATEWAY_URL=
NATIVE_MCP_BACKEND_URL=
# Read-only files mounted in agentgateway; the latter is a private backend credential.
NATIVE_MCP_JWKS_FILE=
NATIVE_MCP_BACKEND_TOKEN_FILE=

# Native opt-in control mode: bbx-runtime serve-runner-control (same Runtime lock).
# Resolver secret is distinct from SERVICE_TOKEN; never mounted in the Runner.
SANDBOX_TENANT_RESOLVER_TOKEN=
# Trusted JSON resource deployment; includes pinned images, cluster/session scope and CA path.
RUNNER_RESOURCE_CONFIG_FILE=
# Runner-facing TLS origins; the internal BLACKBOARD_URL remains separately configurable.
RUNNER_BLACKBOARD_URL=
RUNNER_MODEL_PROXY_URL=

# Optional Blackboard-only publication for a dedicated native CTF deployment.
# Leave unset for existing legacy deployments. Mount the administrator-reviewed receipt alongside it.
# NATIVE_CTF_PUBLICATION_FILE=/etc/blackboard/native-ctf-publication.json
