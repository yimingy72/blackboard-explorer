POSTGRES_USER=blackboard
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=blackboard
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
MINIO_ROOT_USER=blackboard
MINIO_ROOT_PASSWORD=replace-me
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=blackboard
BLACKBOARD_URL=http://blackboard:8000
SERVICE_TOKEN=replace-me
AGENT_TOKEN_SECRET=replace-me
MAX_RUNNING_TASKS=2
ADMIN_USERS=replace-me
OTEL_ENABLED=false

# Retained accounting identity and the common model/MCP authority.
PI_SITE_ID=
PI_MODEL_AUTHORITY=
PI_MODEL_OPERATOR=
PI_MODEL_ALLOWED_ORIGINS=[]
# CA for HTTPS to the private trusted Runtime, mounted read-only on Blackboard.
PI_MODEL_PEER_CA_FILE=
PI_MODEL_RUNTIME_TOKEN=
# Private trusted Runtime endpoint for the operator's model playground.
PI_PLAYGROUND_RUNTIME_URL=
RUNNER_PROXY_HOST=0.0.0.0
RUNNER_PROXY_PORT=8081

# Common trusted Runtime: bbx-runtime serve (one PostgreSQL lock for both modes).
# Resolver secret is distinct from SERVICE_TOKEN; never mounted in the Runner.
SANDBOX_TENANT_RESOLVER_TOKEN=
# Trusted JSON resource deployment; includes pinned images, cluster/session scope and CA path.
RUNNER_RESOURCE_CONFIG_FILE=
# Optional independently published Blackboard policy using the same immutable Runner and cluster.
BOARD_RESOURCE_CONFIG_FILE=
# Runner-facing TLS origins; the internal BLACKBOARD_URL remains separately configurable.
RUNNER_BLACKBOARD_URL=
RUNNER_MODEL_PROXY_URL=

# Per-mode reviewed publications mounted read-only on the same Blackboard.
# Leave a mode unavailable until its exact resource and acceptance files are installed.
# NATIVE_CTF_PUBLICATION_FILE=/run/bbx-publications/ctf-publication.json
# BOARD_RUNNER_PUBLICATION_FILE=/run/bbx-publications/board-publication.json
# When configured, mount the original forced Blackboard network policy read-only in the same directory.
# LEGACY_NETWORK_POLICY_FILE=/run/bbx-publications/blackboard-network-policy.json
# BBX_PUBLICATION_DIR=/absolute/path/to/published-receipts
# Optional containerized trusted Runtime profile; Linux kubectl and reachable private kubeconfig.
# BBX_RUNTIME_CONFIG_DIR=/absolute/path/to/trusted-runtime-config
# BBX_LINUX_KUBECTL_FILE=/absolute/path/to/linux/kubectl
