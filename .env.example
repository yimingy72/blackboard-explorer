POSTGRES_USER=blackboard
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=blackboard
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
MINIO_ROOT_USER=blackboard
MINIO_ROOT_PASSWORD=replace-me
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=blackboard
DEEPSEEK_BASE_URL=https://api.deepseek.com
BLACKBOARD_URL=http://blackboard:8000
EXEC_NETWORK=blackboard-explorer_exec
EXEC_ACCESS_MODE=network
EXEC_EGRESS_MODE=direct
EXEC_NETWORK_INTERNAL=false
EXEC_MIN_PIDS=1024
EGRESS_PROXY_URL=http://egress-proxy:8888
RUNTIME_HTTP_PROXY=
RUNTIME_HTTPS_PROXY=
SERVICE_TOKEN=replace-me
AGENT_TOKEN_SECRET=replace-me
ENVD_TOKEN_SECRET=replace-me
ENVD_TOKEN=replace-me
EGRESS_ALLOWLIST=eval-targets
MAX_RUNNING_TASKS=2
TRAFFIC_ENABLED=true
TRAFFIC_POLL_SECONDS=1
TRAFFIC_MAX_BYTES=2147483648
ADMIN_USERS=replace-me
OTEL_ENABLED=false

# Site-local Pi accounting and the one primary model authority.
PI_SITE_ID=
PI_MODEL_AUTHORITY=
PI_MODEL_PRIMARY_SITE=
PI_MODEL_PRIMARY_URL=
PI_MODEL_OPERATOR=
PI_MODEL_ALLOWED_ORIGINS=[]
PI_MODEL_AUTHORITY_TOKEN=
# Optional CA path, mounted read-only in both Blackboard services, for the exact private peers.
PI_MODEL_PEER_CA_FILE=
PI_MODEL_RUNTIME_TOKEN=
PI_REVIEW_PEER_URL=
PI_REVIEW_PEER_SITE=
# Primary site only. Private Compose service; no host port.
PI_PLAYGROUND_RUNTIME_URL=
RUNNER_PROXY_HOST=0.0.0.0
RUNNER_PROXY_PORT=

# Native opt-in control mode: bbx-runtime serve-runner-control (same Runtime lock).
# Resolver secret is distinct from SERVICE_TOKEN; never mounted in the Runner.
SANDBOX_TENANT_RESOLVER_TOKEN=
# Trusted JSON resource deployment; includes pinned images, cluster/session scope and CA path.
RUNNER_RESOURCE_CONFIG_FILE=
# Runner-facing TLS origins; the internal BLACKBOARD_URL remains separately configurable.
RUNNER_BLACKBOARD_URL=
RUNNER_MODEL_PROXY_URL=

# Optional Blackboard-only publication for a dedicated native CTF deployment.
# Leave unset for existing legacy deployments. Mount the administrator-reviewed receipt alongside it.
# NATIVE_CTF_PUBLICATION_FILE=/etc/blackboard/native-ctf-publication.json
