{
  "name": "blackboard-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check": "eslint src && tsc --noEmit && vitest run",
    "e2e": "node e2e/run.cjs",
    "types": "openapi-typescript ../services/blackboard/openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@ant-design/x": "2.9.0",
    "@tanstack/react-query": "^5.90.0",
    "@xyflow/react": "^12.9.0",
    "antd": "6.6.5",
    "elkjs": "^0.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "4.14.3",
    "react-router-dom": "^6.30.1",
    "yaml": "^2.9.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.18.0",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.3",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "openapi-typescript": "^7.9.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
