{
  "$defs": {
    "CtfSolution": {
      "additionalProperties": false,
      "properties": {
        "conclusion": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Conclusion",
          "type": "string"
        },
        "approach": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Approach",
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/CtfSolutionStep"
          },
          "maxItems": 6,
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "remaining": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 3,
          "title": "Remaining",
          "type": "array"
        },
        "reproduction": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Reproduction",
          "type": "string"
        }
      },
      "required": [
        "conclusion",
        "approach",
        "steps",
        "reproduction"
      ],
      "title": "CtfSolution",
      "type": "object"
    },
    "CtfSolutionStep": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "approach",
            "attempt",
            "breakthrough",
            "result"
          ],
          "title": "Kind",
          "type": "string"
        },
        "title": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "result": {
          "enum": [
            "supported",
            "ruled_out",
            "inconclusive"
          ],
          "title": "Result",
          "type": "string"
        },
        "summary": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "record_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 8,
          "title": "Record Ids",
          "type": "array"
        },
        "artifact_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 8,
          "title": "Artifact Ids",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "title",
        "result",
        "summary"
      ],
      "title": "CtfSolutionStep",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "expected_revision": {
      "minimum": 1,
      "title": "Expected Revision",
      "type": "integer"
    },
    "status": {
      "enum": [
        "candidate",
        "unknown"
      ],
      "title": "Status",
      "type": "string"
    },
    "summary": {
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "work_status": {
      "anyOf": [
        {
          "enum": [
            "in_progress",
            "blocked",
            "completed"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Work Status"
    },
    "solution": {
      "anyOf": [
        {
          "$ref": "#/$defs/CtfSolution"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "request_id",
    "expected_revision",
    "status",
    "summary"
  ],
  "title": "CtfVerificationCandidateRequest",
  "type": "object"
}
