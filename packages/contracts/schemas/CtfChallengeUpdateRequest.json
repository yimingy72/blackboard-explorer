{
  "$defs": {
    "CtfAssignmentInstruction": {
      "additionalProperties": false,
      "properties": {
        "recipient_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Recipient Id",
          "type": "string"
        },
        "body": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Body",
          "type": "string"
        }
      },
      "required": [
        "recipient_id",
        "body"
      ],
      "title": "CtfAssignmentInstruction",
      "type": "object"
    },
    "CtfSolution": {
      "additionalProperties": false,
      "properties": {
        "conclusion": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Conclusion",
          "type": "string"
        },
        "approach": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Approach",
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/CtfSolutionStep"
          },
          "maxItems": 6,
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "remaining": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 3,
          "title": "Remaining",
          "type": "array"
        },
        "reproduction": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Reproduction",
          "type": "string"
        }
      },
      "required": [
        "conclusion",
        "approach",
        "steps",
        "reproduction"
      ],
      "title": "CtfSolution",
      "type": "object"
    },
    "CtfSolutionStep": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "approach",
            "attempt",
            "breakthrough",
            "result"
          ],
          "title": "Kind",
          "type": "string"
        },
        "title": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "result": {
          "enum": [
            "supported",
            "ruled_out",
            "inconclusive"
          ],
          "title": "Result",
          "type": "string"
        },
        "summary": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "record_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 8,
          "title": "Record Ids",
          "type": "array"
        },
        "artifact_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 8,
          "title": "Artifact Ids",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "title",
        "result",
        "summary"
      ],
      "title": "CtfSolutionStep",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "expected_revision": {
      "minimum": 1,
      "title": "Expected Revision",
      "type": "integer"
    },
    "action": {
      "enum": [
        "claim",
        "assign",
        "set_status",
        "release",
        "reopen",
        "collaborators",
        "delete"
      ],
      "title": "Action",
      "type": "string"
    },
    "owner_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Owner Id"
    },
    "collaborator_ids": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Collaborator Ids"
    },
    "work_status": {
      "anyOf": [
        {
          "enum": [
            "in_progress",
            "blocked",
            "completed",
            "cancelled"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Work Status"
    },
    "solution": {
      "anyOf": [
        {
          "$ref": "#/$defs/CtfSolution"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "instructions": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/CtfAssignmentInstruction"
          },
          "maxItems": 32,
          "minItems": 1,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Instructions"
    }
  },
  "required": [
    "request_id",
    "expected_revision",
    "action"
  ],
  "title": "CtfChallengeUpdateRequest",
  "type": "object"
}
