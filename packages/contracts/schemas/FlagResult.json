{
  "additionalProperties": false,
  "properties": {
    "status": {
      "enum": [
        "accepted",
        "rejected",
        "duplicate",
        "unknown"
      ],
      "title": "Status",
      "type": "string"
    },
    "correct_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Correct Count"
    },
    "total_count": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Total Count"
    },
    "score": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Score"
    },
    "external_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "External Ref"
    }
  },
  "required": [
    "status"
  ],
  "title": "FlagResult",
  "type": "object"
}
