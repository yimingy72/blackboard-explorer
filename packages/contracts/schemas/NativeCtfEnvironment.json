{
  "$defs": {
    "NativeSharedInputLimits": {
      "additionalProperties": false,
      "properties": {
        "profile": {
          "const": "shared-inputs-v1",
          "default": "shared-inputs-v1",
          "title": "Profile",
          "type": "string"
        },
        "max_file_bytes": {
          "default": 16777216,
          "title": "Max File Bytes",
          "type": "integer"
        },
        "max_total_bytes": {
          "default": 25165824,
          "title": "Max Total Bytes",
          "type": "integer"
        },
        "max_files": {
          "default": 20,
          "title": "Max Files",
          "type": "integer"
        }
      },
      "title": "NativeSharedInputLimits",
      "type": "object"
    },
    "NativeVpnCapability": {
      "additionalProperties": false,
      "properties": {
        "profile": {
          "const": "openvpn-ipv4-tcp-v1",
          "title": "Profile",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "profile",
        "id",
        "label"
      ],
      "title": "NativeVpnCapability",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
      "title": "Id",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "publication_stamp": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Publication Stamp",
      "type": "string"
    },
    "label": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Label",
      "type": "string"
    },
    "model_id": {
      "title": "Model Id",
      "type": "string"
    },
    "model_version": {
      "title": "Model Version",
      "type": "integer"
    },
    "shared_inputs": {
      "anyOf": [
        {
          "$ref": "#/$defs/NativeSharedInputLimits"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "vpn": {
      "anyOf": [
        {
          "$ref": "#/$defs/NativeVpnCapability"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "id",
    "revision",
    "publication_stamp",
    "label",
    "model_id",
    "model_version"
  ],
  "title": "NativeCtfEnvironment",
  "type": "object"
}
