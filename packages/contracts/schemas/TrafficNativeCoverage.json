{
  "additionalProperties": false,
  "properties": {
    "source_id": {
      "pattern": "^[a-zA-Z0-9_-]{1,80}$",
      "title": "Source Id",
      "type": "string"
    },
    "agent_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Agent Id"
    },
    "packet_count": {
      "minimum": 0,
      "title": "Packet Count",
      "type": "integer"
    },
    "available_bytes": {
      "minimum": 0,
      "title": "Available Bytes",
      "type": "integer"
    },
    "complete": {
      "title": "Complete",
      "type": "boolean"
    },
    "decryption": {
      "enum": [
        "available",
        "unavailable"
      ],
      "title": "Decryption",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    }
  },
  "required": [
    "source_id",
    "packet_count",
    "available_bytes",
    "complete",
    "decryption"
  ],
  "title": "TrafficNativeCoverage",
  "type": "object"
}
