{
  "$defs": {
    "TrafficNativeKeylogPart": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z0-9_-]{1,80}$",
          "title": "Id",
          "type": "string"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "offset": {
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "size_bytes": {
          "maximum": 4194304,
          "minimum": 1,
          "title": "Size Bytes",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "id",
        "sequence",
        "offset",
        "size_bytes",
        "sha256"
      ],
      "title": "TrafficNativeKeylogPart",
      "type": "object"
    },
    "TrafficNativePart": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z0-9_-]{1,80}$",
          "title": "Id",
          "type": "string"
        },
        "segment_id": {
          "pattern": "^[a-zA-Z0-9_-]{1,80}$",
          "title": "Segment Id",
          "type": "string"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "offset": {
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "size_bytes": {
          "maximum": 4194304,
          "minimum": 1,
          "title": "Size Bytes",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "first_packet": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Packet"
        },
        "last_packet": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Packet"
        }
      },
      "required": [
        "id",
        "segment_id",
        "sequence",
        "offset",
        "size_bytes",
        "sha256"
      ],
      "title": "TrafficNativePart",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "task_id": {
      "format": "uuid",
      "title": "Task Id",
      "type": "string"
    },
    "run": {
      "minimum": 1,
      "title": "Run",
      "type": "integer"
    },
    "source_id": {
      "pattern": "^[a-zA-Z0-9_-]{1,80}$",
      "title": "Source Id",
      "type": "string"
    },
    "agent_id": {
      "anyOf": [
        {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Agent Id"
    },
    "complete": {
      "default": false,
      "title": "Complete",
      "type": "boolean"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "packet_count": {
      "default": 0,
      "minimum": 0,
      "title": "Packet Count",
      "type": "integer"
    },
    "last_packet_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Packet At"
    },
    "parts": {
      "items": {
        "$ref": "#/$defs/TrafficNativePart"
      },
      "maxItems": 100000,
      "title": "Parts",
      "type": "array"
    },
    "keylog_parts": {
      "items": {
        "$ref": "#/$defs/TrafficNativeKeylogPart"
      },
      "maxItems": 100000,
      "title": "Keylog Parts",
      "type": "array"
    }
  },
  "required": [
    "task_id",
    "run",
    "source_id"
  ],
  "title": "TrafficNativeSourceIndex",
  "type": "object"
}
