{
  "$defs": {
    "TrafficBindingScope": {
      "additionalProperties": false,
      "properties": {
        "binding_id": {
          "pattern": "^[a-zA-Z0-9_-]{1,80}$",
          "title": "Binding Id",
          "type": "string"
        },
        "assignment_id": {
          "pattern": "^[a-zA-Z0-9_-]{1,80}$",
          "title": "Assignment Id",
          "type": "string"
        },
        "generation": {
          "minimum": 1,
          "title": "Generation",
          "type": "integer"
        },
        "epoch": {
          "minimum": 1,
          "title": "Epoch",
          "type": "integer"
        },
        "role": {
          "enum": [
            "lead",
            "worker",
            "helper"
          ],
          "title": "Role",
          "type": "string"
        },
        "parent_agent_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Agent Id"
        },
        "sandbox_pod_uid": {
          "pattern": "^[a-zA-Z0-9_-]{1,80}$",
          "title": "Sandbox Pod Uid",
          "type": "string"
        },
        "ipv4": {
          "maxLength": 15,
          "title": "Ipv4",
          "type": "string"
        },
        "interface": {
          "maxLength": 15,
          "minLength": 1,
          "title": "Interface",
          "type": "string"
        },
        "netns_inode": {
          "pattern": "^[1-9][0-9]{0,19}$",
          "title": "Netns Inode",
          "type": "string"
        },
        "host_ifindex": {
          "minimum": 1,
          "title": "Host Ifindex",
          "type": "integer"
        },
        "snaplen": {
          "const": 512,
          "default": 512,
          "title": "Snaplen",
          "type": "integer"
        },
        "truncated_packets": {
          "default": 0,
          "minimum": 0,
          "title": "Truncated Packets",
          "type": "integer"
        },
        "discarded_tail_bytes": {
          "default": 0,
          "minimum": 0,
          "title": "Discarded Tail Bytes",
          "type": "integer"
        },
        "dropped_packets": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dropped Packets"
        }
      },
      "required": [
        "binding_id",
        "assignment_id",
        "generation",
        "epoch",
        "role",
        "sandbox_pod_uid",
        "ipv4",
        "interface",
        "netns_inode",
        "host_ifindex"
      ],
      "title": "TrafficBindingScope",
      "type": "object"
    },
    "TrafficNativeKeylogPart": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z0-9_-]{1,80}$",
          "title": "Id",
          "type": "string"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "offset": {
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "size_bytes": {
          "maximum": 4194304,
          "minimum": 1,
          "title": "Size Bytes",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "id",
        "sequence",
        "offset",
        "size_bytes",
        "sha256"
      ],
      "title": "TrafficNativeKeylogPart",
      "type": "object"
    },
    "TrafficNativePart": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z0-9_-]{1,80}$",
          "title": "Id",
          "type": "string"
        },
        "segment_id": {
          "pattern": "^[a-zA-Z0-9_-]{1,80}$",
          "title": "Segment Id",
          "type": "string"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "offset": {
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "size_bytes": {
          "maximum": 4194304,
          "minimum": 1,
          "title": "Size Bytes",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "first_packet": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Packet"
        },
        "last_packet": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Packet"
        }
      },
      "required": [
        "id",
        "segment_id",
        "sequence",
        "offset",
        "size_bytes",
        "sha256"
      ],
      "title": "TrafficNativePart",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "task_id": {
      "format": "uuid",
      "title": "Task Id",
      "type": "string"
    },
    "run": {
      "minimum": 1,
      "title": "Run",
      "type": "integer"
    },
    "source_id": {
      "pattern": "^[a-zA-Z0-9_-]{1,80}$",
      "title": "Source Id",
      "type": "string"
    },
    "agent_id": {
      "anyOf": [
        {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Agent Id"
    },
    "scope": {
      "anyOf": [
        {
          "$ref": "#/$defs/TrafficBindingScope"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "complete": {
      "default": false,
      "title": "Complete",
      "type": "boolean"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "packet_count": {
      "default": 0,
      "minimum": 0,
      "title": "Packet Count",
      "type": "integer"
    },
    "last_packet_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Packet At"
    },
    "parts": {
      "items": {
        "$ref": "#/$defs/TrafficNativePart"
      },
      "maxItems": 100000,
      "title": "Parts",
      "type": "array"
    },
    "keylog_parts": {
      "items": {
        "$ref": "#/$defs/TrafficNativeKeylogPart"
      },
      "maxItems": 100000,
      "title": "Keylog Parts",
      "type": "array"
    }
  },
  "required": [
    "task_id",
    "run",
    "source_id"
  ],
  "title": "TrafficNativeSourceIndex",
  "type": "object"
}
