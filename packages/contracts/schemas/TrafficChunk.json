{
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^[a-zA-Z0-9_-]{1,80}$",
      "title": "Id",
      "type": "string"
    },
    "first_seq": {
      "minimum": 1,
      "title": "First Seq",
      "type": "integer"
    },
    "last_seq": {
      "minimum": 1,
      "title": "Last Seq",
      "type": "integer"
    },
    "count": {
      "maximum": 1000,
      "minimum": 1,
      "title": "Count",
      "type": "integer"
    },
    "source_id": {
      "anyOf": [
        {
          "maxLength": 160,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Id"
    },
    "local_chunk_id": {
      "anyOf": [
        {
          "maxLength": 160,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Local Chunk Id"
    },
    "detail_storage": {
      "default": "record",
      "enum": [
        "record",
        "chunk"
      ],
      "title": "Detail Storage",
      "type": "string"
    },
    "agent_ids": {
      "anyOf": [
        {
          "items": {
            "anyOf": [
              {
                "maxLength": 160,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "maxItems": 1000,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Agent Ids"
    }
  },
  "required": [
    "id",
    "first_seq",
    "last_seq",
    "count"
  ],
  "title": "TrafficChunk",
  "type": "object"
}
