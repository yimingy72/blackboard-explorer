{
  "$defs": {
    "GatewayModelRef": {
      "additionalProperties": false,
      "properties": {
        "alias": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Alias",
          "type": "string"
        },
        "catalog_revision": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Catalog Revision",
          "type": "string"
        }
      },
      "required": [
        "alias",
        "catalog_revision"
      ],
      "title": "GatewayModelRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "gateway_model": {
      "anyOf": [
        {
          "$ref": "#/$defs/GatewayModelRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "revision": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Revision"
    },
    "expected_revision": {
      "minimum": 0,
      "title": "Expected Revision",
      "type": "integer"
    },
    "prompt": {
      "default": "",
      "maxLength": 40000,
      "title": "Prompt",
      "type": "string"
    },
    "model_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Id"
    },
    "enabled_tools": {
      "items": {
        "type": "string"
      },
      "title": "Enabled Tools",
      "type": "array"
    }
  },
  "required": [
    "expected_revision"
  ],
  "title": "ProgressGlobalSettings",
  "type": "object"
}
