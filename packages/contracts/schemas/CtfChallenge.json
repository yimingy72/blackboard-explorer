{
  "$defs": {
    "ChallengeCollaboration": {
      "additionalProperties": false,
      "properties": {
        "difficulty": {
          "default": "medium",
          "enum": [
            "easy",
            "medium",
            "hard"
          ],
          "title": "Difficulty",
          "type": "string"
        },
        "multi_stage": {
          "default": false,
          "title": "Multi Stage",
          "type": "boolean"
        },
        "assistance_target": {
          "default": 0,
          "exclusiveMaximum": 10,
          "minimum": 0,
          "title": "Assistance Target",
          "type": "integer"
        },
        "review_revision": {
          "default": 0,
          "minimum": 0,
          "title": "Review Revision",
          "type": "integer"
        },
        "review_base_revision": {
          "default": 0,
          "minimum": 0,
          "title": "Review Base Revision",
          "type": "integer"
        },
        "review_summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review Summary"
        },
        "review_author": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review Author"
        },
        "review_fact_refs": {
          "items": {
            "type": "string"
          },
          "title": "Review Fact Refs",
          "type": "array"
        },
        "review_candidate_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Review Candidate Ids",
          "type": "array"
        },
        "feedback_fact_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Feedback Fact Id"
        },
        "solve_elapsed_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Solve Elapsed Ms",
          "type": "integer"
        },
        "solve_started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Solve Started At"
        },
        "assistance_reminded": {
          "default": false,
          "title": "Assistance Reminded",
          "type": "boolean"
        }
      },
      "title": "ChallengeCollaboration",
      "type": "object"
    },
    "CtfPrerequisite": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "gate",
            "work_completed"
          ],
          "title": "Kind",
          "type": "string"
        },
        "ref": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Ref",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "ref"
      ],
      "title": "CtfPrerequisite",
      "type": "object"
    },
    "CtfSolveTemplate": {
      "additionalProperties": false,
      "properties": {
        "permission_profile": {
          "const": "solver",
          "default": "solver",
          "title": "Permission Profile",
          "type": "string"
        },
        "deliverable": {
          "$ref": "#/$defs/CtfWorkDeliverable"
        },
        "priority": {
          "default": 1,
          "enum": [
            0,
            1,
            2,
            3
          ],
          "title": "Priority",
          "type": "integer"
        },
        "boundary": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Boundary",
          "type": "string"
        },
        "input_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Input Refs",
          "type": "array"
        },
        "resource_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Resource Refs",
          "type": "array"
        },
        "requires": {
          "items": {
            "$ref": "#/$defs/CtfPrerequisite"
          },
          "maxItems": 16,
          "title": "Requires",
          "type": "array"
        },
        "max_auto_solve_items": {
          "default": 20,
          "maximum": 200,
          "minimum": 1,
          "title": "Max Auto Solve Items",
          "type": "integer"
        },
        "source_namespace": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$",
          "title": "Source Namespace",
          "type": "string"
        }
      },
      "required": [
        "deliverable",
        "boundary",
        "source_namespace"
      ],
      "title": "CtfSolveTemplate",
      "type": "object"
    },
    "CtfWorkDeliverable": {
      "additionalProperties": false,
      "properties": {
        "criteria": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Criteria",
          "type": "string"
        },
        "evidence_required": {
          "default": true,
          "title": "Evidence Required",
          "type": "boolean"
        },
        "validator_ref": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Validator Ref"
        }
      },
      "required": [
        "criteria"
      ],
      "title": "CtfWorkDeliverable",
      "type": "object"
    },
    "CtfWorkItem": {
      "additionalProperties": false,
      "properties": {
        "work_id": {
          "format": "uuid",
          "title": "Work Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "prepare",
            "discover",
            "solve"
          ],
          "title": "Kind",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/CtfWorkSource"
        },
        "scope": {
          "$ref": "#/$defs/CtfWorkScope"
        },
        "requires": {
          "items": {
            "$ref": "#/$defs/CtfPrerequisite"
          },
          "maxItems": 16,
          "title": "Requires",
          "type": "array"
        },
        "priority": {
          "default": 1,
          "enum": [
            0,
            1,
            2,
            3
          ],
          "title": "Priority",
          "type": "integer"
        },
        "deliverable": {
          "$ref": "#/$defs/CtfWorkDeliverable"
        },
        "permission_profile": {
          "default": "solver",
          "enum": [
            "solver",
            "env_prepare"
          ],
          "title": "Permission Profile",
          "type": "string"
        },
        "solve_template": {
          "anyOf": [
            {
              "$ref": "#/$defs/CtfSolveTemplate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "work_id",
        "kind",
        "source",
        "scope",
        "deliverable"
      ],
      "title": "CtfWorkItem",
      "type": "object"
    },
    "CtfWorkScope": {
      "additionalProperties": false,
      "properties": {
        "objective": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Objective",
          "type": "string"
        },
        "boundary": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Boundary",
          "type": "string"
        },
        "input_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Input Refs",
          "type": "array"
        },
        "resource_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Resource Refs",
          "type": "array"
        }
      },
      "required": [
        "objective",
        "boundary"
      ],
      "title": "CtfWorkScope",
      "type": "object"
    },
    "CtfWorkSource": {
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$",
          "title": "Namespace",
          "type": "string"
        },
        "external_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Id"
        }
      },
      "required": [
        "namespace"
      ],
      "title": "CtfWorkSource",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "task_id": {
      "format": "uuid",
      "title": "Task Id",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "connection": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Connection"
    },
    "external_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "External Id"
    },
    "requirements": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Requirements"
    },
    "owner_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Owner Id"
    },
    "dispatch_status": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dispatch Status"
    },
    "requested_worker_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Requested Worker Id"
    },
    "collaborator_ids": {
      "items": {
        "type": "string"
      },
      "title": "Collaborator Ids",
      "type": "array"
    },
    "work_status": {
      "default": "pending",
      "enum": [
        "pending",
        "in_progress",
        "awaiting_review",
        "blocked",
        "completed",
        "cancelled"
      ],
      "title": "Work Status",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "verification": {
      "additionalProperties": true,
      "title": "Verification",
      "type": "object"
    },
    "target": {
      "additionalProperties": true,
      "title": "Target",
      "type": "object"
    },
    "tombstone": {
      "default": false,
      "title": "Tombstone",
      "type": "boolean"
    },
    "solution_record_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Solution Record Id"
    },
    "work_item": {
      "anyOf": [
        {
          "$ref": "#/$defs/CtfWorkItem"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "scope_revision": {
      "default": 1,
      "minimum": 1,
      "title": "Scope Revision",
      "type": "integer"
    },
    "origin_work_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Origin Work Id"
    },
    "auto_solve_count": {
      "default": 0,
      "minimum": 0,
      "title": "Auto Solve Count",
      "type": "integer"
    },
    "collaboration": {
      "anyOf": [
        {
          "$ref": "#/$defs/ChallengeCollaboration"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "id",
    "task_id",
    "title",
    "revision"
  ],
  "title": "CtfChallenge",
  "type": "object"
}
