{
  "$defs": {
    "TrafficBindingScope": {
      "additionalProperties": false,
      "properties": {
        "binding_id": {
          "pattern": "^[a-zA-Z0-9_-]{1,80}$",
          "title": "Binding Id",
          "type": "string"
        },
        "assignment_id": {
          "pattern": "^[a-zA-Z0-9_-]{1,80}$",
          "title": "Assignment Id",
          "type": "string"
        },
        "generation": {
          "minimum": 1,
          "title": "Generation",
          "type": "integer"
        },
        "epoch": {
          "minimum": 1,
          "title": "Epoch",
          "type": "integer"
        },
        "role": {
          "enum": [
            "lead",
            "worker",
            "helper"
          ],
          "title": "Role",
          "type": "string"
        },
        "parent_agent_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Agent Id"
        },
        "sandbox_pod_uid": {
          "pattern": "^[a-zA-Z0-9_-]{1,80}$",
          "title": "Sandbox Pod Uid",
          "type": "string"
        },
        "ipv4": {
          "maxLength": 15,
          "title": "Ipv4",
          "type": "string"
        },
        "interface": {
          "maxLength": 15,
          "minLength": 1,
          "title": "Interface",
          "type": "string"
        },
        "netns_inode": {
          "pattern": "^[1-9][0-9]{0,19}$",
          "title": "Netns Inode",
          "type": "string"
        },
        "host_ifindex": {
          "minimum": 1,
          "title": "Host Ifindex",
          "type": "integer"
        },
        "snaplen": {
          "const": 512,
          "default": 512,
          "title": "Snaplen",
          "type": "integer"
        },
        "truncated_packets": {
          "default": 0,
          "minimum": 0,
          "title": "Truncated Packets",
          "type": "integer"
        },
        "discarded_tail_bytes": {
          "default": 0,
          "minimum": 0,
          "title": "Discarded Tail Bytes",
          "type": "integer"
        },
        "dropped_packets": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dropped Packets"
        }
      },
      "required": [
        "binding_id",
        "assignment_id",
        "generation",
        "epoch",
        "role",
        "sandbox_pod_uid",
        "ipv4",
        "interface",
        "netns_inode",
        "host_ifindex"
      ],
      "title": "TrafficBindingScope",
      "type": "object"
    },
    "TrafficNativeDataSource": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minimum": 0,
          "title": "Id",
          "type": "integer"
        },
        "name": {
          "maxLength": 256,
          "title": "Name",
          "type": "string"
        },
        "length": {
          "minimum": 0,
          "title": "Length",
          "type": "integer"
        },
        "raw_hex": {
          "maxLength": 32768,
          "pattern": "^(?:[0-9a-fA-F]{2})*$",
          "title": "Raw Hex",
          "type": "string"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "length",
        "raw_hex",
        "truncated"
      ],
      "title": "TrafficNativeDataSource",
      "type": "object"
    },
    "TrafficPacketNode": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "label": {
          "default": "",
          "maxLength": 4096,
          "title": "Label",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "maxLength": 16384,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "offset": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Offset"
        },
        "length": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Length"
        },
        "data_source_id": {
          "default": 0,
          "minimum": 0,
          "title": "Data Source Id",
          "type": "integer"
        },
        "filter_expr": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Filter Expr"
        },
        "generated": {
          "default": false,
          "title": "Generated",
          "type": "boolean"
        },
        "severity": {
          "anyOf": [
            {
              "maxLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Severity"
        },
        "children": {
          "items": {
            "$ref": "#/$defs/TrafficPacketNode"
          },
          "maxItems": 512,
          "title": "Children",
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "title": "TrafficPacketNode",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "source_id": {
      "pattern": "^[a-zA-Z0-9_-]{1,80}$",
      "title": "Source Id",
      "type": "string"
    },
    "source_number": {
      "minimum": 1,
      "title": "Source Number",
      "type": "integer"
    },
    "agent_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Agent Id"
    },
    "scope": {
      "anyOf": [
        {
          "$ref": "#/$defs/TrafficBindingScope"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "revision": {
      "title": "Revision",
      "type": "string"
    },
    "columns": {
      "items": {
        "type": "string"
      },
      "title": "Columns",
      "type": "array"
    },
    "layers": {
      "items": {
        "$ref": "#/$defs/TrafficPacketNode"
      },
      "title": "Layers",
      "type": "array"
    },
    "data_sources": {
      "items": {
        "$ref": "#/$defs/TrafficNativeDataSource"
      },
      "title": "Data Sources",
      "type": "array"
    },
    "tree_truncated": {
      "default": false,
      "title": "Tree Truncated",
      "type": "boolean"
    },
    "decode_error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decode Error"
    }
  },
  "required": [
    "source_id",
    "source_number",
    "revision",
    "columns",
    "layers",
    "data_sources"
  ],
  "title": "TrafficNativeFrameDetail",
  "type": "object"
}
