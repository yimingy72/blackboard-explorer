{
  "$defs": {
    "FrozenExchangeRate": {
      "additionalProperties": false,
      "properties": {
        "rate_cny_per_usd": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Rate Cny Per Usd"
        },
        "source_ref": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Source Ref",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "rounding": {
          "const": "ROUND_DOWN",
          "default": "ROUND_DOWN",
          "title": "Rounding",
          "type": "string"
        },
        "usd_decimal_places": {
          "const": 9,
          "default": 9,
          "title": "Usd Decimal Places",
          "type": "integer"
        }
      },
      "required": [
        "rate_cny_per_usd",
        "source_ref",
        "observed_at"
      ],
      "title": "FrozenExchangeRate",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "expected_epoch": {
      "minimum": 1,
      "title": "Expected Epoch",
      "type": "integer"
    },
    "accounting_source_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Accounting Source Id",
      "type": "string"
    },
    "selected_models": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Selected Models",
      "type": "array"
    },
    "exchange_rate": {
      "anyOf": [
        {
          "$ref": "#/$defs/FrozenExchangeRate"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "budget_currency": {
      "anyOf": [
        {
          "const": "USD",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Budget Currency"
    }
  },
  "required": [
    "expected_epoch",
    "accounting_source_id",
    "selected_models"
  ],
  "title": "NativeBudgetPrepare",
  "type": "object"
}
