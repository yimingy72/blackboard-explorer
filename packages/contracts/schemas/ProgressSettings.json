      "title": "Model Id"
    },
    "model_version": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Version"
    },
    "system_prompt": {
      "default": "",
      "maxLength": 40000,
      "title": "System Prompt",
      "type": "string"
    },
    "merge_seconds": {
      "default": 10,
      "maximum": 3600,
