{
  "$defs": {
    "CtfArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "task_id": {
          "format": "uuid",
          "title": "Task Id",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "uri": {
          "title": "Uri",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        },
        "filename": {
          "title": "Filename",
          "type": "string"
        },
        "created_version": {
          "minimum": 1,
          "title": "Created Version",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "task_id",
        "path",
        "uri",
        "sha256",
        "size",
        "filename",
        "created_version"
      ],
      "title": "CtfArtifactRef",
      "type": "object"
    },
    "CtfProgress": {
      "additionalProperties": false,
      "properties": {
        "stage": {
          "enum": [
            "approach",
            "attempt",
            "breakthrough",
            "result"
          ],
          "title": "Stage",
          "type": "string"
        },
        "title": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "summary": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "stage",
        "title",
        "summary"
      ],
      "title": "CtfProgress",
      "type": "object"
    },
    "CtfSolution": {
      "additionalProperties": false,
      "properties": {
        "conclusion": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Conclusion",
          "type": "string"
        },
        "approach": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Approach",
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/CtfSolutionStep"
          },
          "maxItems": 6,
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "remaining": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 3,
          "title": "Remaining",
          "type": "array"
        },
        "reproduction": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Reproduction",
          "type": "string"
        }
      },
      "required": [
        "conclusion",
        "approach",
        "steps",
        "reproduction"
      ],
      "title": "CtfSolution",
      "type": "object"
    },
    "CtfSolutionStep": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "approach",
            "attempt",
            "breakthrough",
            "result"
          ],
          "title": "Kind",
          "type": "string"
        },
        "title": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "result": {
          "enum": [
            "supported",
            "ruled_out",
            "inconclusive"
          ],
          "title": "Result",
          "type": "string"
        },
        "summary": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "record_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 8,
          "title": "Record Ids",
          "type": "array"
        },
        "artifact_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 8,
          "title": "Artifact Ids",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "title",
        "result",
        "summary"
      ],
      "title": "CtfSolutionStep",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "task_id": {
      "format": "uuid",
      "title": "Task Id",
      "type": "string"
    },
    "challenge_id": {
      "format": "uuid",
      "title": "Challenge Id",
      "type": "string"
    },
    "author_id": {
      "minLength": 1,
      "title": "Author Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "note",
        "correction",
        "help_request",
        "artifact",
        "verification",
        "target",
        "solution"
      ],
      "title": "Kind",
      "type": "string"
    },
    "body": {
      "minLength": 1,
      "title": "Body",
      "type": "string"
    },
    "created_version": {
      "minimum": 1,
      "title": "Created Version",
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "artifact_refs": {
      "items": {
        "$ref": "#/$defs/CtfArtifactRef"
      },
      "title": "Artifact Refs",
      "type": "array"
    },
    "attempted_routes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Attempted Routes"
    },
    "observations_and_basis": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Observations And Basis"
    },
    "failure_conditions": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Conditions"
    },
    "current_blocker": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Current Blocker"
    },
    "help_needed": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Help Needed"
    },
    "no_artifacts_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "No Artifacts Reason"
    },
    "verification": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Verification"
    },
    "work_status": {
      "anyOf": [
        {
          "enum": [
            "pending",
            "in_progress",
            "blocked",
            "completed",
            "cancelled"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Work Status"
    },
    "target": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target"
    },
    "platform_call": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Platform Call"
    },
    "summary_applied": {
      "default": true,
      "title": "Summary Applied",
      "type": "boolean"
    },
    "progress": {
      "anyOf": [
        {
          "$ref": "#/$defs/CtfProgress"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "solution": {
      "anyOf": [
        {
          "$ref": "#/$defs/CtfSolution"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "solution_generation": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Solution Generation"
    },
    "solution_turn_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Solution Turn Id"
    },
    "solution_run_number": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Solution Run Number"
    },
    "solution_challenge_revision": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Solution Challenge Revision"
    }
  },
  "required": [
    "id",
    "task_id",
    "challenge_id",
    "author_id",
    "kind",
    "body",
    "created_version",
    "created_at"
  ],
  "title": "CtfRecord",
  "type": "object"
}
