{
  "$defs": {
    "JournalCursor": {
      "additionalProperties": false,
      "properties": {
        "offset": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "seq": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Hash",
          "type": "string"
        },
        "leaf_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Leaf Id"
        },
        "anchor_offset": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Anchor Offset",
          "type": "integer"
        },
        "anchor_size": {
          "maximum": 2097152,
          "minimum": 0,
          "title": "Anchor Size",
          "type": "integer"
        },
        "anchor_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Anchor Hash",
          "type": "string"
        }
      },
      "required": [
        "offset",
        "seq",
        "hash",
        "anchor_offset",
        "anchor_size",
        "anchor_hash"
      ],
      "title": "JournalCursor",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "child_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Child Id",
      "type": "string"
    },
    "binding_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Binding Id",
      "type": "string"
    },
    "plugin_run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Plugin Run Id",
      "type": "string"
    },
    "sdk_session_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Sdk Session Id",
      "type": "string"
    },
    "cursor": {
      "$ref": "#/$defs/JournalCursor"
    },
    "sdk_idle": {
      "const": true,
      "title": "Sdk Idle",
      "type": "boolean"
    },
    "disposed": {
      "const": true,
      "title": "Disposed",
      "type": "boolean"
    },
    "journal_confirmed": {
      "const": true,
      "title": "Journal Confirmed",
      "type": "boolean"
    }
  },
  "required": [
    "child_id",
    "binding_id",
    "plugin_run_id",
    "sdk_session_id",
    "cursor",
    "sdk_idle",
    "disposed",
    "journal_confirmed"
  ],
  "title": "HelperTerminal",
  "type": "object"
}
