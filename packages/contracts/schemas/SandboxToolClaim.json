{
  "$defs": {
    "JournalCursor": {
      "additionalProperties": false,
      "properties": {
        "offset": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "seq": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Hash",
          "type": "string"
        },
        "leaf_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Leaf Id"
        },
        "anchor_offset": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Anchor Offset",
          "type": "integer"
        },
        "anchor_size": {
          "maximum": 2097152,
          "minimum": 0,
          "title": "Anchor Size",
          "type": "integer"
        },
        "anchor_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Anchor Hash",
          "type": "string"
        }
      },
      "required": [
        "offset",
        "seq",
        "hash",
        "anchor_offset",
        "anchor_size",
        "anchor_hash"
      ],
      "title": "JournalCursor",
      "type": "object"
    },
    "RunnerBinding": {
      "additionalProperties": false,
      "properties": {
        "business_contract": {
          "enum": [
            "challenge-board-v1",
            "exploration-board-v1"
          ],
          "title": "Business Contract",
          "type": "string"
        },
        "binding_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Binding Id",
          "type": "string"
        },
        "platform_session_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Platform Session Id",
          "type": "string"
        },
        "agent_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Agent Id",
          "type": "string"
        },
        "generation": {
          "description": "Platform binding/assignment identity version, not legacy CtfMember claim_turn generation",
          "minimum": 1,
          "title": "Generation",
          "type": "integer"
        },
        "journal_generation": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Journal Generation",
          "type": "string"
        },
        "assignment_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Assignment Ref"
        }
      },
      "required": [
        "business_contract",
        "binding_id",
        "platform_session_id",
        "agent_id",
        "generation",
        "journal_generation",
        "assignment_ref"
      ],
      "title": "RunnerBinding",
      "type": "object"
    },
    "RunnerFence": {
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Task Id",
          "type": "string"
        },
        "runner_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Runner Id",
          "type": "string"
        },
        "pod_uid": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Pod Uid",
          "type": "string"
        },
        "epoch": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Epoch",
          "type": "integer"
        }
      },
      "required": [
        "task_id",
        "runner_id",
        "pod_uid",
        "epoch"
      ],
      "title": "RunnerFence",
      "type": "object"
    },
    "ToolInvocation": {
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "const": "bbx.task-runner.v1",
          "title": "Protocol",
          "type": "string"
        },
        "fence": {
          "$ref": "#/$defs/RunnerFence"
        },
        "binding": {
          "$ref": "#/$defs/RunnerBinding"
        },
        "sdk_session_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Sdk Session Id",
          "type": "string"
        },
        "invocation_id": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Invocation Id",
          "type": "string"
        },
        "tool_call_id": {
          "minLength": 1,
          "title": "Tool Call Id",
          "type": "string"
        },
        "assistant_entry_id": {
          "minLength": 1,
          "title": "Assistant Entry Id",
          "type": "string"
        },
        "tool_name": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Tool Name",
          "type": "string"
        },
        "arguments_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Arguments Digest",
          "type": "string"
        },
        "arguments_json": {
          "title": "Arguments Json",
          "type": "string"
        },
        "journal": {
          "$ref": "#/$defs/JournalCursor"
        }
      },
      "required": [
        "protocol",
        "fence",
        "binding",
        "sdk_session_id",
        "invocation_id",
        "tool_call_id",
        "assistant_entry_id",
        "tool_name",
        "arguments_digest",
        "arguments_json",
        "journal"
      ],
      "title": "ToolInvocation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "invocation": {
      "$ref": "#/$defs/ToolInvocation"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "arguments": {
      "additionalProperties": true,
      "title": "Arguments",
      "type": "object"
    },
    "network_grant_revision": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Network Grant Revision"
    }
  },
  "required": [
    "invocation",
    "name",
    "arguments"
  ],
  "title": "SandboxToolClaim",
  "type": "object"
}
