{
  "$defs": {
    "TrafficMessage": {
      "additionalProperties": false,
      "properties": {
        "headers": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "type": "array"
          },
          "maxItems": 256,
          "title": "Headers",
          "type": "array"
        },
        "body_preview": {
          "default": "",
          "title": "Body Preview",
          "type": "string"
        },
        "body_bytes": {
          "default": 0,
          "minimum": 0,
          "title": "Body Bytes",
          "type": "integer"
        },
        "body_encoding": {
          "default": "omitted",
          "enum": [
            "utf-8",
            "base64",
            "omitted"
          ],
          "title": "Body Encoding",
          "type": "string"
        },
        "body_truncated": {
          "default": false,
          "title": "Body Truncated",
          "type": "boolean"
        }
      },
      "title": "TrafficMessage",
      "type": "object"
    },
    "TrafficObservation": {
      "additionalProperties": false,
      "properties": {
        "scope": {
          "default": "logical_call",
          "enum": [
            "wire",
            "logical_call"
          ],
          "title": "Scope",
          "type": "string"
        },
        "trace_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trace Id"
        },
        "span_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Span Id"
        },
        "parent_span_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Span Id"
        },
        "attributes": {
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 128,
          "title": "Attributes",
          "type": "object"
        },
        "status": {
          "default": "unknown",
          "maxLength": 128,
          "title": "Status",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "retry_visibility": {
          "default": "unknown",
          "enum": [
            "known",
            "unknown"
          ],
          "title": "Retry Visibility",
          "type": "string"
        }
      },
      "title": "TrafficObservation",
      "type": "object"
    },
    "TrafficPacketDetail": {
      "additionalProperties": false,
      "properties": {
        "layers": {
          "items": {
            "$ref": "#/$defs/TrafficPacketNode"
          },
          "maxItems": 512,
          "title": "Layers",
          "type": "array"
        },
        "raw_hex": {
          "default": "",
          "maxLength": 32768,
          "pattern": "^(?:[0-9a-fA-F]{2})*$",
          "title": "Raw Hex",
          "type": "string"
        },
        "raw_truncated": {
          "default": false,
          "title": "Raw Truncated",
          "type": "boolean"
        },
        "tree_truncated": {
          "default": false,
          "title": "Tree Truncated",
          "type": "boolean"
        },
        "decode_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decode Error"
        }
      },
      "title": "TrafficPacketDetail",
      "type": "object"
    },
    "TrafficPacketMeta": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "number": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Number",
          "type": "integer"
        },
        "native_frame_number": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Frame Number"
        },
        "frame_length": {
          "minimum": 0,
          "title": "Frame Length",
          "type": "integer"
        },
        "captured_length": {
          "minimum": 0,
          "title": "Captured Length",
          "type": "integer"
        },
        "direction": {
          "default": "unknown",
          "enum": [
            "inbound",
            "outbound",
            "loopback",
            "unknown"
          ],
          "title": "Direction",
          "type": "string"
        },
        "interface": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interface"
        },
        "info": {
          "default": "",
          "maxLength": 2048,
          "title": "Info",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "number",
        "frame_length",
        "captured_length"
      ],
      "title": "TrafficPacketMeta",
      "type": "object"
    },
    "TrafficPacketNode": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "label": {
          "default": "",
          "maxLength": 4096,
          "title": "Label",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "maxLength": 16384,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "offset": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Offset"
        },
        "length": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Length"
        },
        "data_source_id": {
          "default": 0,
          "minimum": 0,
          "title": "Data Source Id",
          "type": "integer"
        },
        "filter_expr": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Filter Expr"
        },
        "generated": {
          "default": false,
          "title": "Generated",
          "type": "boolean"
        },
        "severity": {
          "anyOf": [
            {
              "maxLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Severity"
        },
        "children": {
          "items": {
            "$ref": "#/$defs/TrafficPacketNode"
          },
          "maxItems": 512,
          "title": "Children",
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "title": "TrafficPacketNode",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^r-[1-9][0-9]{0,18}$",
      "title": "Id",
      "type": "string"
    },
    "seq": {
      "maximum": 9223372036854775807,
      "minimum": 1,
      "title": "Seq",
      "type": "integer"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "agent_id": {
      "anyOf": [
        {
          "maxLength": 160,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
