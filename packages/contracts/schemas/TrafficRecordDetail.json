    "response": {
      "anyOf": [
        {
          "$ref": "#/$defs/TrafficMessage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "observation": {
      "anyOf": [
        {
          "$ref": "#/$defs/TrafficObservation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
