    "packet_detail": {
      "anyOf": [
        {
          "$ref": "#/$defs/TrafficPacketDetail"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "id",
    "seq",
    "timestamp",
    "protocol"
  ],
  "title": "TrafficRecordDetail",
  "type": "object"
}
