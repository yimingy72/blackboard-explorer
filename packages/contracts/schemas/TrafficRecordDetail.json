      "default": null,
      "title": "Application Protocol"
    },
    "source_ip": {
      "default": "",
      "maxLength": 128,
      "title": "Source Ip",
      "type": "string"
    },
    "source_port": {
      "anyOf": [
        {
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Port"
    },
    "destination_ip": {
      "default": "",
      "maxLength": 128,
      "title": "Destination Ip",
      "type": "string"
    },
    "destination_port": {
      "anyOf": [
        {
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Destination Port"
    },
    "method": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Method"
    },
    "url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Url"
    },
    "status_code": {
      "anyOf": [
        {
          "maximum": 599,
          "minimum": 100,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Status Code"
    },
    "summary": {
      "default": "",
      "title": "Summary",
      "type": "string"
    },
    "request_bytes": {
      "default": 0,
      "minimum": 0,
      "title": "Request Bytes",
      "type": "integer"
    },
    "response_bytes": {
      "default": 0,
      "minimum": 0,
      "title": "Response Bytes",
      "type": "integer"
    },
    "plaintext": {
      "default": "not_applicable",
      "enum": [
        "decoded",
        "encrypted",
        "not_applicable"
      ],
      "title": "Plaintext",
      "type": "string"
    },
    "request": {
      "anyOf": [
        {
          "$ref": "#/$defs/TrafficMessage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
