    "protocol": {
      "maxLength": 64,
      "title": "Protocol",
      "type": "string"
    },
    "transport_protocol": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Transport Protocol"
    },
    "application_protocol": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
