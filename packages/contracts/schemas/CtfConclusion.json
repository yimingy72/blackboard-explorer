{
  "$defs": {
    "CtfFailureDiagnostic": {
      "additionalProperties": false,
      "description": "Safe coordinator failure metadata; never contains request or tool payloads.",
      "properties": {
        "error_type": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,99}$",
          "title": "Error Type",
          "type": "string"
        },
        "phase": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,63}$",
          "title": "Phase",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "correlation_id": {
          "format": "uuid",
          "title": "Correlation Id",
          "type": "string"
        },
        "summary": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "task_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        },
        "member_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Member Id"
        },
        "turn_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Turn Id"
        },
        "generation": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generation"
        },
        "model_error": {
          "anyOf": [
            {
              "$ref": "#/$defs/CtfFailureModelError"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "error_type",
        "phase",
        "occurred_at",
        "correlation_id",
        "summary"
      ],
      "title": "CtfFailureDiagnostic",
      "type": "object"
    },
    "CtfFailureModelError": {
      "additionalProperties": false,
      "description": "Bounded provider diagnostics copied from a failed model call.",
      "properties": {
        "category": {
          "pattern": "^[a-z_]{1,64}$",
          "title": "Category",
          "type": "string"
        },
        "scope": {
          "anyOf": [
            {
              "enum": [
                "provider",
                "request",
                "infrastructure"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope"
        },
        "http_status": {
          "anyOf": [
            {
              "maximum": 599,
              "minimum": 100,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Http Status"
        },
        "provider_code": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Code"
        },
        "request_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "failure_phase": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Phase"
        },
        "exception_type": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,99}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exception Type"
        },
        "transport_type": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,99}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transport Type"
        },
        "incomplete_reason": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Incomplete Reason"
        },
        "transient": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transient"
        }
      },
      "required": [
        "category"
      ],
      "title": "CtfFailureModelError",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "end_reason": {
      "enum": [
        "goal_claimed",
        "user_stop",
        "budget_exhausted",
        "system_failure",
        "partial"
      ],
      "title": "End Reason",
      "type": "string"
    },
    "summary": {
      "title": "Summary",
      "type": "string"
    },
    "unresolved_items": {
      "items": {
        "type": "string"
      },
      "title": "Unresolved Items",
      "type": "array"
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "lead_claim": {
      "default": false,
      "title": "Lead Claim",
      "type": "boolean"
    },
    "verification_refs": {
      "items": {
        "type": "string"
      },
      "title": "Verification Refs",
      "type": "array"
    },
    "run_number": {
      "default": 1,
      "minimum": 1,
      "title": "Run Number",
      "type": "integer"
    },
    "requested_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Requested By"
    },
    "requested_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Requested At"
    },
    "finalized_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finalized At"
    },
    "failure": {
      "anyOf": [
        {
          "$ref": "#/$defs/CtfFailureDiagnostic"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "end_reason",
    "summary"
  ],
  "title": "CtfConclusion",
  "type": "object"
}
