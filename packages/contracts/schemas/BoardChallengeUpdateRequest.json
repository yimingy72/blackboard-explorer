{
  "additionalProperties": false,
  "description": "Edit the challenge title or revise its execution scope.\n\nA title change preserves scope. Changed description or requirements revoke old admission\nand clear readiness; explicitly mark the new scope ready to queue it after cleanup.\nUnconfirmed execution or journal evidence keeps the original Assignment draining.",
  "properties": {
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "challenge_id": {
      "format": "uuid",
      "title": "Challenge Id",
      "type": "string"
    },
    "expected_revision": {
      "minimum": 1,
      "title": "Expected Revision",
      "type": "integer"
    },
    "title": {
      "anyOf": [
        {
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Title"
    },
    "description": {
      "anyOf": [
        {
          "maxLength": 16000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "requirements": {
      "anyOf": [
        {
          "maxLength": 16000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Requirements"
    },
    "readiness": {
      "anyOf": [
        {
          "enum": [
            "no_external_materials",
            "materials_pending"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Readiness"
    },
    "priority": {
      "default": 1,
      "maximum": 3,
      "minimum": 0,
      "title": "Priority",
      "type": "integer"
    }
  },
  "required": [
    "request_id",
    "challenge_id",
    "expected_revision"
  ],
  "title": "BoardChallengeUpdateRequest",
  "type": "object"
}
